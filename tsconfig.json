{
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "eslint.config.js",
    "prettier.config.js",
    "vite.config.ts",
    // Ausdrücklich, weil `**/*` keine Punktverzeichnisse erfasst — sonst blieben die
    // Storybook-Konfiguration und ihre Decorators ungeprüft.
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      // Stories greifen auf die Storybook-Decorators zu, ohne sich über drei Ebenen
      // nach oben hangeln zu müssen.
      "@storybook-config/*": ["./.storybook/*"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
